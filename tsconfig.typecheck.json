        "./packages/pi-finance-sdk/src/index.ts"
      ],
      "@upup/pi-investment-analysis": [
        "./packages/pi-investment-analysis/src/index.ts"
      ],
      "@upup/pi-investment-workflow": [
        "./packages/pi-investment-workflow/src/index.ts"
      ],
      "@upup/pi-management": [
        "./packages/pi-management/src/index.ts"
      ],
      "@upup/pi-market-data": [
        "./packages/pi-market-data/src/index.ts"
