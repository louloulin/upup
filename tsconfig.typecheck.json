{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@upup/cron": [
        "./packages/cron/src/index.ts"
      ],
      "@upup/daemon": [
        "./packages/daemon/src/index.ts"
      ],
      "@upup/gateway": [
        "./packages/gateway/src/index.ts"
      ],
      "@upup/mcp": [
        "./packages/mcp/src/index.ts"
      ],
      "@upup/memory": [
        "./packages/memory/src/index.ts"
      ],
      "@upup/pi-app": [
        "./packages/pi-app/src/index.ts"
      ],
      "@upup/pi-app/default": [
        "./packages/pi-app/src/default.ts"
      ],
      "@upup/pi-app/print": [
        "./packages/pi-app/src/print.ts"
      ],
      "@upup/pi-backtest": [
        "./packages/pi-backtest/src/index.ts"
      ],
      "@upup/pi-capability-registry": [
        "./packages/pi-capability-registry/src/index.ts"
      ],
      "@upup/pi-cli-bootstrap": [
        "./packages/pi-cli-bootstrap/src/index.ts"
      ],
      "@upup/pi-config": [
        "./packages/pi-config/src/index.ts"
      ],
      "@upup/pi-evals": [
        "./packages/pi-evals/src/index.ts"
      ],
      "@upup/pi-event-adapter": [
        "./packages/pi-event-adapter/src/index.ts"
