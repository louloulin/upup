      "@upup/pi-observability/integration": [
        "./packages/pi-observability/src/integration.ts"
      ],
      "@upup/pi-planning": [
        "./packages/pi-planning/src/index.ts"
      ],
      "@upup/pi-platform": [
        "./packages/pi-platform/src/index.ts"
      ],
      "@upup/pi-portfolio": [
        "./packages/pi-portfolio/src/index.ts"
      ],
      "@upup/pi-prompt-config": [
        "./packages/pi-prompt-config/src/index.ts"
      ],
      "@upup/pi-research": [
        "./packages/pi-research/src/index.ts"
      ],
      "@upup/pi-resource-composition": [
        "./packages/pi-resource-composition/src/index.ts"
      ],
      "@upup/pi-risk": [
        "./packages/pi-risk/src/index.ts"
      ],
      "@upup/pi-runtime": [
        "./packages/pi-runtime/src/index.ts"
      ],
      "@upup/pi-runtime/custom-providers": [
        "./packages/pi-runtime/src/custom-providers.ts"
      ],
      "@upup/pi-runtime/model-registry": [
        "./packages/pi-runtime/src/model-registry.ts"
      ],
      "@upup/pi-session": [
        "./packages/pi-session/src/index.ts"
      ],
      "@upup/pi-storage": [
        "./packages/pi-storage/src/index.ts"
      ],
      "@upup/types": [
        "./packages/types/src/index.ts"
      ],
      "@upup/utils": [
        "./packages/utils/src/index.ts"
      ],
      "@upup/utils/logging": [
        "./packages/utils/src/logging/index.ts"
      ]
    },
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "packages/*/src/**/*",
    "packages/*/extensions/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/**/*.test.ts",
    "packages/**/*.test.tsx"
  ]
}
