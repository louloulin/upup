{
  "name": "upup",
  "version": "2026.6.12",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "UpUp (涨涨) — Chinese-language deep financial research AI agent. 中国版 Dexter：forked from virattt/dexter, 面向 A 股 / 港股 / 中文投研场景，扩展 50 个投资分析 skill、5 阶段 /invest 工作流、4 runtime 插件、EN+zh-CN i18n。",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "benchmark:pi5": "bun run scripts/benchmark-pi5.ts",
    "build": "bun run typecheck && (cd packages/utils && bun run build) && (cd packages/pi-evals && bun run build) && bun build --compile --target=bun --outfile=dist/upup src/index.tsx --external=playwright --external=playwright-core && bun run scripts/copy-pi-package-resources.ts dist && chmod +x dist/upup && echo '✅ Build complete: dist/upup'",
    "build:packages": "bun run scripts/build-workspace-packages.ts",
    "build:all": "bun run build:types && bun run build:hooks && bun run build:memory && bun run --filter @upup/pi-session build && bun run --filter @upup/pi-app build && bun run build",
    "build:bun": "bun run typecheck && echo Bun build complete - run: bun start'",
    "build:compile": "bun build --compile --target=bun --outfile=upup src/index.tsx --external=playwright --external=playwright-core && bun run scripts/copy-pi-package-resources.ts . && chmod +x upup && echo '✅ Binary compile complete - run: ./upup'",
    "build:compile:win": "bun build --compile --target=bun --outfile=upup.exe src/index.tsx && bun run scripts/copy-pi-package-resources.ts . && echo '✅ Windows compile complete'",
    "build:hooks": "cd packages/hooks && bun build src/index.ts --outdir=dist --target=bun && npx tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "build:memory": "cd packages/memory && bun build src/index.ts --outdir=dist --target=bun",
    "build:node": "bun run scripts/build-node.ts",
    "build:node:win": "bun build src/index.tsx --target=node --outfile=dist/upup.exe --external=dotenv --external=zod && echo '✅ Windows build complete'",
    "build:pkg": "pkg . --targets node22-linux-x64,node22-macos-x64,node22-win-x64 --output dist/upup-pkg",
    "build:pkg:linux": "pkg . --targets node22-linux-x64 --output dist/upup-linux",
    "build:pkg:mac": "pkg . --targets node22-macos-x64 --output dist/upup-macos",
    "build:pkg:win": "pkg . --targets node22-win-x64 --output dist/upup.exe",
    "build:types": "cd packages/types && bun build src/index.ts --outdir=dist --target=bun && npx tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "check:module-boundaries": "bun run scripts/check-module-boundaries.ts",
    "check:workspace-exports": "bun run scripts/check-workspace-exports.ts",
    "check:pi-deletion-audit": "UPUP_PI_DELETION_AUDIT_STRICT=1 bun run scripts/report-pi7-deletion-audit.ts",
    "check:pi-migration": "bun run scripts/check-pi-migration.ts",
    "check:pi-package-audit": "UPUP_PI_PACKAGE_AUDIT_STRICT=1 bun run scripts/report-pi-package-audit.ts",
    "check:pi-packages": "bun run scripts/check-pi-packages.ts && bun run scripts/check-pi-side-effects.ts",
    "check:pi-runtime": "bun run scripts/check-pi-runtime.ts && bun run check:pi-ecosystem-resolution && bun run check:pi-web-overlay",
    "check:pi-side-effects": "bun run scripts/check-pi-side-effects.ts",
    "check:no-self-impl": "bun run scripts/check-no-self-impl.ts",
    "check:tui-bridge-cleanup": "bun run scripts/check-tui-bridge-cleanup.ts",
    "check:pi7": "bun run scripts/check-pi7-architecture.ts",
    "check:js-suffix": "bun run scripts/check-js-suffix.ts",
    "ci": "bun run lint && bun run typecheck && bun test",
    "dev": "bun --watch run src/index.tsx",
    "dist": "bun run build:compile && ./upup --version",
    "eval": "bun run packages/pi-evals/src/cli.ts",
    "gateway": "tsx src/bootstrap/gateway.ts run",
    "gateway:login": "tsx src/bootstrap/gateway.ts login",
    "lint": "bun run lint:scc",
    "lint:scc": "bun run scripts/check-scc.ts",
    "migrate:sessions": "bun run packages/pi-session/src/migrate.ts",
    "observability:snapshot": "bun run scripts/report-pi-migration.ts > scripts/.report-pi-migration.json && bun run scripts/observability-snapshot.ts",
    "postbuild": "bun run scripts/copy-pi-package-resources.ts dist",
    "postbuild:compile": "bun run scripts/copy-pi-package-resources.ts .",
    "postbuild:compile:win": "bun run scripts/copy-pi-package-resources.ts .",
    "postinstall": "playwright install chromium",
    "prepack": "bun run build:compile",
    "print": "bun run packages/pi-app/src/print.ts",
    "report:pi-architecture": "bun run scripts/report-pi-architecture.ts",
    "report:pi-deletion-audit": "bun run scripts/report-pi7-deletion-audit.ts",
    "report:pi-migration": "bun run scripts/report-pi-migration.ts",
    "report:pi-package-audit": "bun run scripts/report-pi-package-audit.ts",
    "report:pi7": "bun run scripts/report-pi7-architecture.ts",
    "session:migrate-to-pi": "bun run packages/pi-session/src/migrate-to-pi.ts",
    "start": "bun run src/index.tsx",
    "test": "bun test",
    "test:pi-contracts": "bun test --timeout=15000 src/runtime/pi packages/pi-app/src/print.test.ts packages/gateway/src/agent-runner.pi.test.ts packages/cron/src/executor.pi.test.ts packages/pi-bridge/src/pi-contract.test.ts src/controllers/agent-runner.pi.test.ts && bun --cwd packages/pi-finance-sdk test && bun --cwd packages/pi-market-data test && bun --cwd packages/pi-investment-analysis test && bun --cwd packages/pi-risk test && bun --cwd packages/pi-portfolio test && bun --cwd packages/pi-backtest test && bun --cwd packages/pi-platform test && bun --cwd packages/pi-research test && bun --cwd packages/pi-browser test && bun --cwd packages/pi-config test && bun --cwd packages/pi-cache test && bun --cwd packages/pi-notify test && bun --cwd packages/pi-investment-workflow test && bun --cwd packages/pi-management test && bun --cwd packages/pi-technical test && bun --cwd packages/pi-corporate-actions test && bun --cwd packages/pi-quant test && bun --cwd packages/pi-event-adapter test && bun --cwd packages/pi-session test src/ && bun --cwd packages/pi-resource-composition test && bun --cwd packages/pi-capability-registry test && bun --cwd packages/cron test && bun --cwd packages/pi-bridge test && bun --cwd packages/daemon test && bun run verify:pi-side-effects && bun test scripts/verify-pi-real-invest.contract.test.ts && bun test scripts/verify-pi-cross-process-idempotency.test.ts && bun test scripts/verify-pi-cross-process-os.test.ts && bun test scripts/verify-pi-real-invest.synthetic.test.ts && bun test scripts/verify-pi-side-effects-cross-process.test.ts && bun test src/runtime/pi/pi-version-lock.test.ts && bun test src/runtime/pi/pi-fixture-schema.test.ts && bun test scripts/check-js-suffix.test.ts",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "verify:pi-cross-process": "bun test scripts/verify-pi-cross-process-idempotency.test.ts",
    "verify:pi-cross-process-os": "bun test scripts/verify-pi-cross-process-os.test.ts",
    "verify:pi-entry-faults": "bun run scripts/verify-pi-entry-faults.ts",
    "verify:pi-entry-matrix": "bun run scripts/verify-pi-entry-matrix.ts",
    "verify:pi-entry-sla": "bun run scripts/verify-pi-entry-sla.ts",
    "verify:pi-faults": "bun run scripts/verify-pi-fault-matrix.ts",
    "verify:pi-real-invest": "bun run scripts/verify-pi-real-invest.ts",
    "verify:pi-real-invest-synthetic": "bun test scripts/verify-pi-real-invest.synthetic.test.ts",
    "verify:pi-side-effects": "bun run scripts/verify-pi-side-effects-runtime.ts",
    "verify:pi5": "bun run scripts/verify-pi5.ts",
    "verify:pi-side-effects-cross-process": "bun test scripts/verify-pi-side-effects-cross-process.test.ts",
    "verify:pi-plugin-e2e": "bun test scripts/verify-pi-plugin-e2e.test.ts",
    "verify:pi-cbor": "bun test scripts/verify-pi-cbor.test.ts",
    "verify:pi7-final": "bun run scripts/verify-pi7-final.ts",
    "check:upup-home": "bun run scripts/check-upup-home.ts",
    "check:sop-coverage": "bun run scripts/check-sop-coverage.ts",
    "check:cross-platform-exposure": "bun run scripts/check-cross-platform-exposure.ts",
    "check:pi-extension-coverage": "bun run scripts/check-pi-extension-coverage.ts",
    "check:pi-event-coverage": "bun run scripts/check-pi-event-coverage.ts",
    "check:pi-ecosystem-deps": "bun run scripts/check-pi-ecosystem-deps.ts",
    "lint:upup-home": "bun run scripts/check-upup-home.ts",
    "check:upup-clean-loading": "bun run scripts/check-upup-clean-loading.ts",
    "smoke:cli": "bash scripts/verify-upup-cli-smoke.sh",
    "verify:upup-cli": "bash scripts/verify-upup-cli-smoke.sh",
    "check:pi-ecosystem-resolution": "bun run scripts/check-pi-ecosystem-resolution.ts",
    "check:pi-web-overlay": "bun run scripts/check-pi-web-overlay.ts"
  },
  "dependencies": {
    "@agegr/pi-web": "0.9.1",
    "@arhen/pi-core-subagent": "1.3.54",
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@earendil-works/chord": "0.85.1",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-client": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-protocol": "0.85.1",
    "@earendil-works/pi-server": "0.85.1",
    "@earendil-works/pi-telemetry": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@juicesharp/rpiv-ask-user-question": "^2.10.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@narumitw/pi-lsp": "0.49.7",
    "@narumitw/pi-plan-mode": "^0.58.0",
    "@plannotator/pi-extension": "0.27.15",
    "@quintinshaw/pi-dynamic-workflows": "3.12.0",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "better-sqlite3": "^12.8.0",
    "context-mode": "^1.0.169",
    "croner": "^9.1.0",
    "diff": "^8.0.4",
    "dotenv": "^17.3.1",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "linkedom": "^0.18.12",
    "pi-advisor-flow": "0.6.0",
    "pi-brainstorm": "0.4.3",
    "pi-cache-optimizer": "2.8.10",
    "pi-conductor": "0.21.7",
    "pi-crew": "0.11.1",
    "pi-esr": "0.6.3",
    "pi-goal-list-loop-audit": "0.38.56",
    "pi-goal-x": "^0.31.5",
    "pi-hermes-memory": "0.9.9",
    "pi-lens": "^4.2.0",
    "pi-mcp-adapter": "^2.34.0",
    "pi-simplify": "^0.2.3",
    "pi-subagents": "0.68.0",
    "pi-web-access": "0.29.0",
    "pi-web-search": "1.6.0",
    "pi-web-ui": "^0.88.0",
    "playwright": "^1.58.2",
    "qrcode-terminal": "^0.12.0",
    "rolebox": "1.9.0",
    "shell-quote": "^1.8.3",
    "toolflow": "3.1.4",
    "typebox": "1.3.7",
    "zod": "^3.23.8",
    "zod-to-json-schema": "3.25.0",
    "zod-v4": "npm:zod@4.3.6"
  },
  "pkg": {
    "name": "upup",
    "version": "2026.6.12",
    "description": "UpUp - AI agent for deep financial research",
    "bin": "src/index.tsx",
    "targets": [
      "node22-linux-x64",
      "node22-macos-x64",
      "node22-win-x64"
    ],
    "outputPath": "dist",
    "public": true,
    "ignore": [
      "src/evals",
      "src/components",
      "src/controllers",
      "src/gateway",
      "src/cron",
      "src/daemon",
      "src/plan",
      "src/plugins",
      "src/permissions",
      "src/proactive",
      "src/hooks",
      "src/state",
      "src/tools/portfolio",
      "src/tools/quant",
      "src/tools/research",
      "src/tools/worktree",
      "src/tools/discovery",
      "tests",
      "*.test.ts",
      "*.spec.ts"
    ]
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/package.json",
    "dist/sops",
    "dist/upup-sidecar.js",
    "dist/upup-favicon.svg",
    "LICENSE",
    "README.md"
  ],
  "author": "UpUp Team",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "financial",
    "research",
    "cli",
    "dexter-fork",
    "a-share",
    "chinese-finance",
    "investment-agent",
    "i18n",
    "plugin-runtime",
    "cli-agent",
    "tushare",
    "akshare",
    "deepseek"
  ],
  "release": {
    "github": {
      "release": true
    },
    "mac": {
      "bin": "upup"
    },
    "linux": {
      "bin": "upup"
    },
    "windows": {
      "bin": "upup.exe"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/glob": "^7",
    "@types/jest": "^29.5.14",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.14",
    "@types/shell-quote": "^1.7.5",
    "@upup/daemon": "workspace:*",
    "@upup/cron": "workspace:*",
    "@upup/gateway": "workspace:*",
    "@upup/types": "workspace:*",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "pkg": "^5.8.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/louloulin/upup#readme",
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@0.85.1": "patches/@earendil-works%2Fpi-coding-agent@0.85.1.patch",
    "jiti@2.7.0": "patches/jiti@2.7.0.patch"
  },
  "bin": {
    "upup": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/louloulin/upup.git"
  },
  "bugs": {
    "url": "https://github.com/louloulin/upup/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "scripts": {
      "preinstall": "",
      "install": "",
      "postinstall": ""
    }
  },
  "overrides": {
    "highlight.js": "10.7.3"
  }
}
