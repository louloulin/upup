{
  "name": "dexter-ts",
  "version": "2026.5.2",
  "description": "Dexter - AI agent for deep financial research.",
  "type": "module",
  "main": "src/index.tsx",
  "bin": {
    "dexter-ts": "./src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun --watch run src/index.tsx",
    "gateway": "tsx src/gateway/index.ts run",
    "gateway:login": "tsx src/gateway/index.ts login",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "postinstall": "playwright install chromium",
    "build": "bun run typecheck",
    "build:bun": "bun run typecheck && echo '\u2705 Bun build complete - run: bun start'",
    "build:node": "bun build src/index.tsx --target=node --outfile=dist/dexter.js --external=dotenv --external=zod && echo '\u2705 Node.js build complete'",
    "build:node:win": "bun build src/index.tsx --target=node --outfile=dist/dexter.exe --external=dotenv --external=zod && echo '\u2705 Windows build complete'",
    "build:compile": "bun build --compile --target=bun --outfile=dexter src/index.tsx --external=playwright --external=playwright-core --external=@playwright/test && chmod +x dexter && echo '\u2705 Binary compile complete - run: ./dexter'",
    "build:compile:win": "bun build --compile --target=bun --outfile=dexter.exe src/index.tsx && echo '\u2705 Windows binary compile complete'",
    "build:all": "bun run build:bun && bun run build:node && bun run build:compile",
    "build:pkg": "pkg . --targets node18-linux-x64,node18-macos-x64,node18-win-x64 --output dist/dexter-pkg",
    "build:pkg:linux": "pkg . --targets node18-linux-x64 --output dist/dexter-linux",
    "build:pkg:mac": "pkg . --targets node18-macos-x64 --output dist/dexter-macos",
    "build:pkg:win": "pkg . --targets node18-win-x64 --output dist/dexter.exe",
    "dist": "bun run build:compile && ./dexter --version",
    "prepack": "bun run build:compile"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.25",
    "@langchain/core": "^1.1.36",
    "@langchain/exa": "^1.0.1",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.3.1",
    "@langchain/tavily": "^1.2.0",
    "@mariozechner/pi-tui": "^0.52.12",
    "@memvid/sdk": "^2.0.120",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "better-sqlite3": "^12.8.0",
    "croner": "^9.1.0",
    "diff": "^8.0.4",
    "dotenv": "^17.3.1",
    "exa-js": "^2.10.1",
    "gray-matter": "^4.0.3",
    "langsmith": "^0.4.12",
    "linkedom": "^0.18.12",
    "playwright": "^1.58.2",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.23.8",
    "zod-v4": "npm:zod@4.3.6"
  },
  "pkg": {
    "name": "dexter",
    "version": "2026.5.2",
    "description": "Dexter - AI agent for deep financial research",
    "bin": "src/index.tsx",
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64"
    ],
    "outputPath": "dist",
    "public": true,
    "ignore": [
      "src/evals",
      "src/components",
      "src/controllers",
      "src/gateway",
      "src/cron",
      "src/daemon",
      "src/plan",
      "src/plugins",
      "src/permissions",
      "src/proactive",
      "src/hooks",
      "src/state",
      "src/tools/portfolio",
      "src/tools/quant",
      "src/tools/research",
      "src/tools/worktree",
      "src/tools/discovery",
      "tests",
      "*.test.ts",
      "*.spec.ts"
    ]
  },
  "files": [
    "src",
    "dist",
    "!.serena",
    "!.claude"
  ],
  "author": "Dexter Team",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "financial",
    "research",
    "cli"
  ],
  "release": {
    "github": {
      "release": true
    },
    "mac": {
      "bin": "dexter"
    },
    "linux": {
      "bin": "dexter"
    },
    "windows": {
      "bin": "dexter.exe"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/jest": "^29.5.14",
    "@types/qrcode-terminal": "^0.12.2",
    "babel-jest": "^30.3.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
