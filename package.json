{
  "name": "upup",
  "version": "2026.05.15",
  "private": true,
  "description": "UpUp - AI agent for deep financial research (涨涨 — 深度金融研究 AI 智能体).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun --watch run src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build:packages": "bun run scripts/build-packages.ts",
    "lint:boundaries": "bun run scripts/lint-boundaries.ts",
    "lint:scc": "bun run scripts/check-scc.ts",
    "lint": "bun run lint:scc",
    "ci": "bun run lint && bun run lint:boundaries && bun run typecheck && bun test",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "postinstall": "playwright install chromium",
    "build": "bun run typecheck && bun build --compile --target=bun --outfile=dist/upup src/index.tsx --external=playwright --external=playwright-core && chmod +x dist/upup && echo '✅ Build complete: dist/upup'",
    "build:compile": "bun build --compile --target=bun --outfile=upup src/index.tsx --external=playwright --external=playwright-core && chmod +x upup && echo '✅ Binary compile complete - run: ./upup'",
    "build:compile:win": "bun build --compile --target=bun --outfile=upup.exe src/index.tsx && echo '✅ Windows binary compile complete'",
    "prepack": "bun run build:compile"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@langchain/anthropic": "^1.3.25",
    "@langchain/core": "^1.1.44",
    "@langchain/exa": "^1.0.1",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.3.1",
    "@langchain/tavily": "^1.2.0",
    "@earendil-works/pi-tui": "0.76.0",
    "@memvid/sdk": "^2.0.120",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "better-sqlite3": "^12.8.0",
    "croner": "^9.1.0",
    "diff": "^8.0.4",
    "dotenv": "^17.3.1",
    "exa-js": "^2.10.1",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "langsmith": "^0.4.12",
    "linkedom": "^0.18.12",
    "playwright": "^1.58.2",
    "qrcode-terminal": "^0.12.0",
    "shell-quote": "^1.8.3",
    "zod": "^3.23.8",
    "zod-v4": "npm:zod@4.3.6"
  },
  "files": [
    "dist"
  ],
  "author": "UpUp Team",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "financial",
    "research",
    "cli"
  ],
  "release": {
    "github": {
      "release": true
    },
    "mac": {
      "bin": "upup"
    },
    "linux": {
      "bin": "upup"
    },
    "windows": {
      "bin": "upup.exe"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@paperclipai/adapter-utils": "^2026.428.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/glob": "^7",
    "@types/jest": "^29.5.14",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.14",
    "@types/shell-quote": "^1.7.5",
    "@upup/daemon": "workspace:*",
    "@upup/gateway": "workspace:*",
    "@upup/types": "workspace:*",
    "esbuild": "^0.28.0",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "@whiskeysockets/baileys",
    "protobufjs"
  ]
}
