{
  "name": "@upup/utils",
  "version": "0.2.0",
  "description": "UpUp Utils - Common utility functions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./logging": {
      "types": "./dist/logging/logger.d.ts",
      "bun": "./src/logging/index.ts",
      "default": "./dist/logging/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build src/logging/index.ts --outdir=dist/logging --target=node && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=node",
    "test": "bun test"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "dotenv": "17.3.1",
    "eventemitter3": "5.0.4",
    "@upup/pi-config": "0.1.0"
  },
  "peerDependencies": {
    "@upup/types": "0.2.0"
  },
  "devDependencies": {
    "@upup/pi-runtime": "0.1.0"
  },
  "files": [
    "dist"
  ],
  "pi": { "contract": "upup.pi.runtime.v1", "source": "builtin:upup", "trust": { "mode": "builtin" }, "lifecycle": { "scope": "runtime" }, "extensions": [], "skills": [], "prompts": [], "workflows": [], "policies": [], "evals": [] },
  "private": false
}
