{
  "name": "@upup/types",
  "version": "0.2.0",
  "description": "Shared TypeScript types for UpUp",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && bun build src/index.ts --outdir=dist --target=node --format=cjs && rm -rf dist/*.map",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=bun",
    "test": "bun test"
  },
  "files": [
    "dist"
  ],
  "private": false,
  "dependencies": {
    "@upup/agent-runtime": "workspace:*",
    "@upup/coordinator-system": "workspace:*",
    "@upup/plugins": "workspace:*",
    "@upup/tools-registry": "workspace:*",
    "@upup/tui-renderer": "workspace:*"
  }
}
