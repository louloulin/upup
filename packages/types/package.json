{
  "name": "@upup/types",
  "version": "0.1.0",
  "description": "Shared TypeScript types for UpUp",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && bun build src/index.ts --outdir=dist --target=node --format=cjs && rm -rf dist/*.map",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=bun",
    "test": "bun test"
  },
  "files": [
    "dist"
  ],
  "private": false
}
