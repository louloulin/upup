{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/extensions"
  },
  "include": ["extensions/**/*.ts"],
  "exclude": ["extensions/**/*.test.ts", "dist", "node_modules"]
}