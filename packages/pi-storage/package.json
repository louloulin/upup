{
  "name": "@upup/pi-storage",
  "version": "0.2.0",
  "description": "UpUp Pi storage - dossier, strategy, audit, file-history, project storage, shell snapshots, stats cache, fund storage, storage adapter",
  "type": "module",
  "keywords": ["pi-package", "finance", "storage", "audit", "file-history", "project"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts"
  },
  "dependencies": {
    "@upup/utils": "0.2.0",
    "@upup/pi-finance-sdk": "0.1.0"
  },
  "files": ["dist", "package.json"],
  "pi": {
    "contract": "upup.pi.runtime.v1",
    "source": "builtin:upup",
    "trust": { "mode": "builtin", "filesystem": true },
    "lifecycle": { "scope": "session" },
    "capabilities": [
      { "name": "storage.session", "version": "1.0.0", "scope": "session", "trust": { "mode": "builtin", "filesystem": true }, "lifecycle": { "scope": "session" } }
    ],
    "extensions": [],
    "skills": [],
    "prompts": [],
    "workflows": [],
    "policies": [],
    "evals": []
  }
}
