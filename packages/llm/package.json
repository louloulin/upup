{
  "name": "@upup/llm",
  "version": "0.2.0",
  "description": "UpUp LLM SDK - Unified LLM interface with multi-provider support",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers": {
      "types": "./src/providers.ts",
      "default": "./src/providers.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && bun build src/index.ts --outdir=dist --target=node --format=cjs && rm -rf dist/*.map",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=bun",
    "test": "bun test"
  },
  "dependencies": {
    "@upup/types": "workspace:*",
    "@upup/utils": "workspace:*",
    "@upup/agent-runtime": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "private": false
}
