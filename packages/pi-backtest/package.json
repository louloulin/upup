{
  "name": "@upup/pi-backtest",
  "version": "0.1.0",
  "description": "UpUp Pi-native historical strategy evaluation tools",
  "type": "module",
  "keywords": [
    "pi-package",
    "finance",
    "backtest",
    "strategy",
    "historical"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "bun run ../../scripts/clean-pi-package-dist.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts ./src/methodology.test.ts ./src/cost-model.test.ts ./src/data-quality.test.ts ./src/microstructure.test.ts ./extensions/index.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typebox": "1.3.7"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
   "source": "builtin:upup",
    "tools": ["evaluate_trade","run_backtest","get_backtest_summary","calculate_win_rate","backtest_dca","backtest_lumpsum","backtest_threshold"],
    "nativeTools": ["evaluate_trade","run_backtest","get_backtest_summary","calculate_win_rate","backtest_dca","backtest_lumpsum","backtest_threshold"],
    "trust": { "mode": "builtin", "network": true, "filesystem": true },
    "lifecycle": { "scope": "session" },
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills/pi-backtest"
    ],
    "prompts": [
      "./prompts/pi-backtest.md"
    ],
    "workflows": [
      "./workflows/pi-backtest.md"
    ],
    "policies": [
      "./policies/pi-backtest.md"
    ],
    "evals": [
      "./evals/pi-backtest.json"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0"
  }
}
