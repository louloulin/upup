{
  "name": "@upup/pi-risk",
  "version": "0.1.0",
  "description": "UpUp Pi-native portfolio risk metrics (VaR, Sharpe, Sortino, max drawdown)",
  "type": "module",
  "keywords": [
    "pi-package",
    "finance",
    "risk",
    "var",
    "sharpe",
    "sortino",
    "drawdown"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "test": "bun test ./test.ts ./extensions/index.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typebox": "1.3.7"
  },
  "pi": {
    "source": "builtin:upup",
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills/pi-risk"
    ],
    "prompts": [
      "./prompts/pi-risk.md"
    ],
    "workflows": [
      "./workflows/pi-risk.md"
    ],
    "policies": [
      "./policies/pi-risk.md"
    ],
    "evals": [
      "./evals/pi-risk.json"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0"
  }
}
