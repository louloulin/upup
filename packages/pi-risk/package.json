{
  "name": "@upup/pi-risk",
  "version": "0.1.0",
  "description": "UpUp Pi-native portfolio risk metrics (VaR, Sharpe, Sortino, max drawdown)",
  "type": "module",
  "keywords": [
    "pi-package",
    "finance",
    "risk",
    "var",
    "sharpe",
    "sortino",
    "drawdown"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "bun run ../../scripts/clean-pi-package-dist.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "test": "bun test ./test.ts ./extensions/index.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typebox": "1.3.7"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
   "source": "builtin:upup",
    "tools": ["calculate_var","calculate_sharpe","calculate_sortino","calculate_max_drawdown","calculate_kelly","calculate_risk_parity","calculate_mean_variance","calculate_correlation_matrix","calculate_correlation","score_data_source","compare_data_sources","track_risk","get_short_interest","calculate_short_interest_ratio","detect_short_squeeze"],
    "nativeTools": ["calculate_var","calculate_sharpe","calculate_sortino","calculate_max_drawdown","calculate_kelly","calculate_risk_parity","calculate_mean_variance","calculate_correlation_matrix","calculate_correlation","score_data_source","compare_data_sources","track_risk","get_short_interest","calculate_short_interest_ratio","detect_short_squeeze"],
    "trust": { "mode": "builtin", "filesystem": true },
    "lifecycle": { "scope": "session" },
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills/pi-risk"
    ],
    "prompts": [
      "./prompts/pi-risk.md"
    ],
    "workflows": [
      "./workflows/pi-risk.md"
    ],
    "policies": [
      "./policies/pi-risk.md"
    ],
    "evals": [
      "./evals/pi-risk.json"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0"
  }
}
