{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@upup/types": [
        "../types/src"
      ],
      "@upup/types/*": [
        "../types/src/*"
      ],
      "@upup/utils": [
        "../utils/src"
      ],
      "@upup/utils/*": [
        "../utils/src/*"
      ],
      "@upup/utils/logging": [
        "../utils/src/logging"
      ],
      "@upup/llm": [
        "../llm/src"
      ],
      "@upup/hooks": [
        "../hooks/src"
      ],
      "@upup/hooks/*": [
        "../hooks/src/*"
      ],
      "@upup/agent-runtime": [
        "../agent-runtime/src"
      ],
      "@upup/agent-runtime/*": [
        "../agent-runtime/src/*"
      ],
      "@upup/memory-system": [
        "../memory-system/src"
      ],
      "@upup/memory-system/*": [
        "../memory-system/src/*"
      ],
      "@upup/session-system": [
        "../session-system/src"
      ],
      "@upup/telemetry": [
        "../telemetry/src"
      ],
      "@upup/telemetry/*": [
        "../telemetry/src/*"
      ],
      "@upup/storage": [
        "../storage/src"
      ],
      "@upup/tools-registry": [
        "../tools-registry/src"
      ],
      "@upup/tools-registry/*": [
        "../tools-registry/src/*"
      ],
      "@upup/mcp": [
        "../mcp/src"
      ],
      "@upup/mcp/*": [
        "../mcp/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}