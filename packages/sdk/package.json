{
  "name": "@upup/sdk",
  "version": "0.1.0",
  "description": "UP SDK - Agent SDK with stdio communication",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio-client.d.ts",
      "default": "./dist/stdio-client.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && bun build src/index.ts --outdir=dist --target=node --format=cjs",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=bun",
    "test": "bun test"
  },
  "dependencies": {
    "@upup/types": "workspace:*"
  },
  "files": ["dist"]
}
