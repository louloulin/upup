{
  "name": "@upup/pi-app",
  "version": "0.1.0",
  "description": "Pi Native application composition for the UpUp investment assistant",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./default": {
      "types": "./src/default.ts",
      "default": "./src/default.ts"
    },
    "./entry": {
      "types": "./src/entry.ts",
      "default": "./src/entry.ts"
    },
    "./print": {
      "types": "./src/print.ts",
      "default": "./src/print.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node --external '@upup/*' --external '@earendil-works/*' && bun build src/default.ts --outdir=dist --target=node --external '@upup/*' --external '@earendil-works/*' && bun build src/entry.ts --outdir=dist --target=node --external '@upup/*' --external '@earendil-works/*' && bun build src/print.ts --outdir=dist --target=node --external '@upup/*' --external '@earendil-works/*' && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./src"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "private": false,
  "pi": {
    "contract": "upup.pi.runtime.v1",
    "source": "builtin:upup",
    "trust": {
      "mode": "builtin"
    },
    "lifecycle": {
      "scope": "process",
      "dispose": "./src/index.ts#PiApp.dispose"
    },
    "dependencies": {
      "@upup/pi-finance-sdk": "0.1.0"
    },
    "extensions": [],
    "skills": [],
    "prompts": [],
    "workflows": [],
    "policies": [],
    "evals": []
  },
  "dependencies": {
    "@upup/cron": "0.2.0",
    "@upup/gateway": "0.2.0",
    "@upup/mcp": "0.2.0",
    "@upup/pi-event-adapter": "0.1.0",
    "@upup/pi-finance-sdk": "0.1.0",
    "@upup/pi-investment-workflow": "0.1.0",
    "@upup/pi-management": "0.1.0",
    "@upup/pi-resource-composition": "0.1.0",
    "@upup/pi-platform": "0.1.0",
    "@upup/pi-runtime": "0.1.0",
    "@upup/pi-session": "0.1.0",
    "@upup/utils": "0.2.0",
    "@upup/mcp-server": "0.1.0",
    "@upup/upup-web": "0.1.0"
  }
}