{
  "name": "@upup/memory",
  "version": "0.2.0",
  "description": "UpUp Memory SDK - Pi-compatible JSONL storage with deterministic keyword search",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun --external zod --external gray-matter",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=bun --external zod --external gray-matter",
    "test": "bun test"
  },
  "dependencies": {
    "@upup/types": "workspace:*",
    "gray-matter": "^4.0.3",
    "zod": "^3.22.0"
  },
  "files": [
    "dist",
    "!dist/*.node"
  ],
  "private": false,
  "pi": { "contract": "upup.pi.runtime.v1", "source": "builtin:upup", "trust": { "mode": "builtin", "filesystem": true }, "lifecycle": { "scope": "session" }, "extensions": [], "skills": [], "prompts": [], "workflows": [], "policies": [], "evals": [] }
}
