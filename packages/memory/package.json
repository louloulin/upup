{
  "name": "@upup/memory",
  "version": "0.2.0",
  "description": "UpUp Memory SDK - Pi-compatible JSONL storage with deterministic keyword search",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun --external zod --external gray-matter --external @upup/pi-storage --external @upup/utils --external @upup/types && npx tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=bun --external zod --external gray-matter --external @upup/pi-storage --external @upup/utils --external @upup/types",
    "test": "bun test"
  },
  "dependencies": {
    "@upup/types": "0.2.0",
    "@upup/pi-storage": "0.2.0",
    "@upup/utils": "0.2.0",
    "gray-matter": "4.0.3",
    "zod": "4.6.5"
  },
  "files": [
    "dist",
    "!dist/*.node"
  ],
  "private": false,
  "pi": { "contract": "upup.pi.runtime.v1", "source": "builtin:upup", "trust": { "mode": "builtin", "filesystem": true }, "lifecycle": { "scope": "session" }, "capabilities": [{ "name": "memory.session", "version": "1.0.0", "scope": "session", "trust": { "mode": "builtin", "filesystem": true }, "lifecycle": { "scope": "session" } }], "extensions": [], "skills": [], "prompts": [], "workflows": [], "policies": [], "evals": [] }
}
