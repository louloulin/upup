{
  "name": "@upup/state",
  "version": "0.2.0",
  "description": "UpUp State SDK - Centralized state management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./state": {
      "types": "./src/state.ts",
      "default": "./src/state.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && npx tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=bun",
    "test": "bun test"
  },
  "dependencies": {
    "eventemitter3": "^5.0.0"
  },
  "peerDependencies": {},
  "files": [
    "dist"
  ],
  "private": false
}
