{
  "name": "@upup/pi-technical",
  "version": "0.1.0",
  "description": "UpUp Pi-native technical analysis package with auditable indicators, trend detection, and pattern recognition",
  "type": "module",
  "keywords": [
    "pi-package",
    "finance",
    "technical-analysis"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "test": "bun test ./test.ts ./src/indicators.test.ts ./src/trend.test.ts ./src/patterns.test.ts ./extensions/index.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typebox": "1.3.7"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
   "source": "builtin:upup",
    "tools": ["compute_indicators","compute_macd","compute_kdj","compute_boll","compute_atr","compute_rsi","compute_obv","compute_cci"],
    "nativeTools": ["compute_indicators","compute_macd","compute_kdj","compute_boll","compute_atr","compute_rsi","compute_obv","compute_cci"],
    "trust": { "mode": "builtin", "network": true },
    "lifecycle": { "scope": "session" },
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "workflows": [
      "./workflows"
    ],
    "policies": [
      "./policies"
    ],
    "evals": [
      "./evals"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0"
  }
}
