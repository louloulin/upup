{
  "name": "@upup/pi-prompt-config",
  "version": "0.1.0",
  "description": "UpUp Pi-native prompt composition, feature gates, channels, locale, capability manifest and role system",
  "type": "module",
  "keywords": [
    "pi-package",
    "prompt",
    "config"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./src"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
    "source": "builtin:upup",
    "trust": { "mode": "builtin", "filesystem": true },
    "lifecycle": { "scope": "session" },
    "extensions": [],
    "skills": [],
    "prompts": [],
    "workflows": [],
    "policies": [],
    "evals": []
  },
  "dependencies": {
    "@upup/utils": "0.2.0",
    "@upup/pi-observability": "0.1.0",
    "@upup/pi-runtime": "0.1.0"
  }
}
