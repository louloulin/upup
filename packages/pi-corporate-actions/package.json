{
  "name": "@upup/pi-corporate-actions",
  "version": "0.1.0",
  "description": "UpUp Pi-native corporate actions package: dividends, splits, rights issues, price adjustment, total return calculation",
  "type": "module",
  "keywords": [
    "pi-package",
    "finance",
    "corporate-actions",
    "dividends"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "test": "bun test ./test.ts ./src/dividends.test.ts ./src/splits.test.ts ./src/rights.test.ts ./src/adjustments.test.ts ./src/aggregate.test.ts ./src/dry-run.test.ts ./extensions/index.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typebox": "1.3.7"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
   "source": "builtin:upup",
    "tools": ["corporate_actions_dividends","corporate_actions_splits","corporate_actions_rights","corporate_actions_list_all","corporate_actions_adjust_prices","corporate_actions_total_return","corporate_actions_dividend_yield","corporate_actions_ex_price"],
    "nativeTools": ["corporate_actions_dividends","corporate_actions_splits","corporate_actions_rights","corporate_actions_list_all","corporate_actions_adjust_prices","corporate_actions_total_return","corporate_actions_dividend_yield","corporate_actions_ex_price"],
    "trust": { "mode": "builtin", "network": true },
    "lifecycle": { "scope": "session" },
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "workflows": [
      "./workflows"
    ],
    "policies": [
      "./policies"
    ],
    "evals": [
      "./evals"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0"
  }
}
