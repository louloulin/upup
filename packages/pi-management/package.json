{
  "name": "@upup/pi-management",
  "version": "0.1.0",
  "description": "UpUp Pi-native read-only management and runtime observability tools",
  "type": "module",
  "keywords": [
    "pi-package",
    "platform",
    "management",
    "observability"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node --external '@upup/*' --external '@earendil-works/*' && bun build extensions/index.ts --outdir=dist/extensions --target=node --external '@upup/*' --external '@earendil-works/*' && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts ./extensions/index.test.ts ./src/server.test.ts ./src/management-page.boundary.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typebox": "1.3.7"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
    "source": "builtin:upup",
    "tools": ["management_system_snapshot", "management_provider_status", "management_package_status", "management_runtime_status"],
    "nativeTools": ["management_system_snapshot", "management_provider_status", "management_package_status", "management_runtime_status"],
    "trust": {
      "mode": "builtin",
      "filesystem": true,
      "network": false,
      "credentials": false
    },
    "hostCapabilities": ["management-snapshot"],
    "lifecycle": {
      "scope": "session"
    },
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills/management"
    ],
    "prompts": [
      "./prompts/management.md"
    ],
    "workflows": [
      "./workflows/management.md"
    ],
    "policies": [
      "./policies/management.md"
    ],
    "evals": [
      "./evals/pi-management.json"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0",
    "@upup/pi-market-data": "0.1.0",
    "@upup/pi-resource-composition": "0.1.0",
    "@upup/pi-runtime": "0.1.0",
    "@upup/pi-session": "0.1.0",
    "@upup/utils": "0.2.0"
  }
}
