{
  "name": "@upup/pi-management",
  "version": "0.1.0",
  "description": "UpUp Pi-native read-only management and runtime observability tools",
  "type": "module",
  "keywords": [
    "pi-package",
    "platform",
    "management",
    "observability"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts ./extensions/index.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typebox": "1.3.7"
  },
  "pi": {
    "source": "builtin:upup",
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills/management"
    ],
    "prompts": [
      "./prompts/management.md"
    ],
    "workflows": [
      "./workflows/management.md"
    ],
    "policies": [
      "./policies/management.md"
    ],
    "evals": [
      "./evals/pi-management.json"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0"
  }
}
