{
  "name": "@upup/daemon",
  "version": "0.2.0",
  "description": "UpUp Daemon System - Worker pool types, health monitoring, and worker interfaces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./workers": {
      "types": "./src/workers/index.ts",
      "default": "./src/workers/index.ts"
    },
    "./fund-monitor": {
      "types": "./src/fund-monitor.ts",
      "default": "./src/fund-monitor.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./session": {
      "types": "./src/session.ts",
      "default": "./src/session.ts"
    },
    "./ipc": {
      "types": "./src/ipc.ts",
      "default": "./src/ipc.ts"
    },
    "./supervisor": {
      "types": "./src/supervisor.ts",
      "default": "./src/supervisor.ts"
    },
    "./workers/types": {
      "types": "./src/workers/types.ts",
      "default": "./src/workers/types.ts"
    },
    "./workers/tasks": {
      "types": "./src/workers/tasks.ts",
      "default": "./src/workers/tasks.ts"
    },
    "./worker-pool": {
      "types": "./src/worker-pool.ts",
      "default": "./src/worker-pool.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@upup/types": "workspace:*"
  },
  "devDependencies": {
    "@upup/types": "workspace:*",
    "@types/bun": "latest"
  },
  "keywords": [
    "daemon",
    "worker",
    "upup",
    "agent"
  ],
  "private": false,
  "dependencies": {
    "@upup/agent-runtime": "workspace:*",
    "@upup/cron": "workspace:*",
    "@upup/storage": "workspace:*",
    "@upup/tools-registry": "workspace:*",
    "@upup/utils": "workspace:*"
  }
}
