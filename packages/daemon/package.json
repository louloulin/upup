{
  "name": "@upup/daemon",
  "version": "0.3.0",
  "description": "UpUp Pi Native daemon - worker pool, supervisor, IPC, tasks, and Pi background runtime integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun --external @upup/pi-runtime --external @upup/pi-event-adapter --external @upup/gateway --external @upup/cron --external @upup/utils --external @earendil-works/pi-ai --external @earendil-works/pi-coding-agent && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "test": "bun test ./src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@upup/cron": "0.2.0",
    "@upup/gateway": "0.2.0",
    "@upup/pi-event-adapter": "0.1.0",
    "@upup/pi-runtime": "0.1.0",
    "@upup/utils": "0.2.0"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "private": false,
  "pi": {
    "contract": "upup.pi.runtime.v1",
    "source": "builtin:upup",
    "trust": {
      "mode": "builtin",
      "filesystem": true,
      "network": false
    },
    "lifecycle": {
      "scope": "process",
      "dispose": "./src/index.ts#Supervisor.stop"
    },
    "extensions": [],
    "skills": [],
    "prompts": [],
    "workflows": [],
    "policies": [],
    "evals": []
  }
}
