{
  "name": "@upup/pi-research",
  "version": "0.1.0",
  "description": "UpUp Pi-native web research and evidence tools",
  "type": "module",
  "keywords": ["pi-package", "research", "web", "evidence"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts ./src/search.test.ts ./src/research-text.test.ts ./src/deep-search.test.ts ./extensions/index.test.ts"
  },
  "files": ["dist", "extensions", "skills", "prompts", "workflows", "policies", "evals", "package.json"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@upup/pi-finance-sdk": "0.1.0",
    "typebox": "1.3.7"
  },
  "dependencies": {
    "@upup/pi-planning": "0.1.0"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
   "source": "builtin:upup",
    "tools": ["web_fetch","web_search","x_search","analyze_sentiment","detect_events","extract_entities","research_deep_search","earnings_preview"],
    "nativeTools": ["web_fetch","web_search","x_search","analyze_sentiment","detect_events","extract_entities","research_deep_search","earnings_preview"],
    "trust": { "mode": "builtin", "network": true, "credentials": true },
    "lifecycle": { "scope": "session" },
    "extensions": ["./extensions"],
    "skills": ["./skills/pi-research"],
    "prompts": ["./prompts/pi-research.md"],
    "workflows": ["./workflows/pi-research.md"],
    "policies": ["./policies/pi-research.md"],
    "evals": ["./evals/pi-research.json"]
  }
}
