{
  "name": "@upup/plugins",
  "version": "0.2.0",
  "description": "UpUp Plugin System - Plugin types, manifest validation, and core interfaces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@upup/plugin-sdk": "workspace:*",
    "@upup/skills": "workspace:*",
    "@upup/types": "workspace:*",
    "@upup/utils": "workspace:*",
    "typebox": "1.3.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@upup/types": "workspace:*",
    "@types/bun": "latest"
  },
  "keywords": [
    "plugin",
    "upup",
    "agent"
  ],
  "private": false,
  "pi": {
    "contract": "upup.pi.runtime.v1",
    "source": "builtin:upup",
    "trust": {
      "mode": "sandboxed"
    },
    "lifecycle": {
      "scope": "session"
    },
    "extensions": [],
    "skills": [],
    "prompts": [],
    "workflows": [],
    "policies": [],
    "evals": []
  }
}
