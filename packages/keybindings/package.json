{
  "name": "@upup/keybindings",
  "version": "0.2.0",
  "description": "UpUp Keybindings SDK - Keyboard shortcut system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./defaults": {
      "types": "./src/defaults.ts",
      "default": "./src/defaults.ts"
    },
    "./resolver": {
      "types": "./src/resolver.ts",
      "default": "./src/resolver.ts"
    },
    "./resolver.test": {
      "types": "./src/resolver.test.ts",
      "default": "./src/resolver.test.ts"
    },
    "./parser": {
      "types": "./src/parser.ts",
      "default": "./src/parser.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && npx tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=bun",
    "test": "bun test"
  },
  "dependencies": {
    "eventemitter3": "^5.0.0"
  },
  "peerDependencies": {},
  "files": [
    "dist"
  ],
  "private": false
}
