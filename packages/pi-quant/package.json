{
  "name": "@upup/pi-quant",
  "version": "0.1.0",
  "description": "UpUp Pi-native quantitative factors package: factor library, normalization, IC analysis, returns, orthogonalization, scoring, backtest",
  "type": "module",
  "keywords": [
    "pi-package",
    "finance",
    "quantitative",
    "alpha",
    "factors"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "test": "bun test ./test.ts ./src/factors.test.ts ./src/normalize.test.ts ./src/ic.test.ts ./src/returns.test.ts ./src/orthogonalize.test.ts ./src/score.test.ts ./src/dry-run.test.ts ./src/backtest.test.ts ./extensions/index.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typebox": "1.3.7"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
   "source": "builtin:upup",
    "tools": ["quant_factor_library","quant_factor_compute","quant_factor_normalize","quant_factor_ic","quant_factor_returns","quant_factor_orthogonalize","quant_factor_score","quant_factor_backtest"],
    "nativeTools": ["quant_factor_library","quant_factor_compute","quant_factor_normalize","quant_factor_ic","quant_factor_returns","quant_factor_orthogonalize","quant_factor_score","quant_factor_backtest"],
    "trust": { "mode": "builtin", "network": true, "credentials": true },
    "lifecycle": { "scope": "session" },
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "workflows": [
      "./workflows"
    ],
    "policies": [
      "./policies"
    ],
    "evals": [
      "./evals"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0"
  }
}
