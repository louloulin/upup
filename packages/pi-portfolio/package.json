{
  "name": "@upup/pi-portfolio",
  "version": "0.1.0",
  "description": "UpUp Pi-native portfolio attribution tools",
  "type": "module",
  "keywords": [
    "pi-package",
    "finance",
    "portfolio",
    "attribution",
    "brinson"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "bun run ../../scripts/clean-pi-package-dist.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts ./src/duckdb.test.ts ./extensions/index.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typebox": "1.3.7"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
    "source": "builtin:upup",
    "tools": [
      "portfolio_attribution",
      "add_position",
      "update_position",
      "remove_position",
      "get_portfolio",
      "export_portfolio",
      "list_portfolios",
      "create_portfolio",
      "delete_portfolio",
      "switch_portfolio",
      "add_position_multi",
      "remove_position_multi",
      "get_portfolio_multi",
      "compare_to_benchmark",
      "calculate_alpha",
      "convert_currency",
      "list_currencies",
      "get_exchange_rate",
      "list_benchmarks",
      "duckdb-portfolio-analysis",
      "duckdb-query",
      "duckdb-register-parquet",
      "duckdb-list-tables",
      "duckdb-timeseries",
      "duckdb-import-csv"
    ],
    "nativeTools": [
      "portfolio_attribution",
      "add_position",
      "update_position",
      "remove_position",
      "get_portfolio",
      "export_portfolio",
      "list_portfolios",
      "create_portfolio",
      "delete_portfolio",
      "switch_portfolio",
      "add_position_multi",
      "remove_position_multi",
      "get_portfolio_multi",
      "compare_to_benchmark",
      "calculate_alpha",
      "convert_currency",
      "list_currencies",
      "get_exchange_rate",
      "list_benchmarks",
      "duckdb-portfolio-analysis",
      "duckdb-query",
      "duckdb-register-parquet",
      "duckdb-list-tables",
      "duckdb-timeseries",
      "duckdb-import-csv"
    ],
    "trust": {
      "mode": "builtin",
      "filesystem": true
    },
    "lifecycle": {
      "scope": "session"
    },
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills/pi-portfolio"
    ],
    "prompts": [
      "./prompts/pi-portfolio.md"
    ],
    "workflows": [
      "./workflows/pi-portfolio.md"
    ],
    "policies": [
      "./policies/pi-portfolio.md"
    ],
    "evals": [
      "./evals/pi-portfolio.json"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0"
  }
}
