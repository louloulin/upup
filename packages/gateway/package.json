{
  "name": "@upup/gateway",
  "version": "0.2.0",
  "description": "UpUp Gateway System - WhatsApp integration, routing, and channel management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@upup/pi-event-adapter": "workspace:*",
    "@upup/pi-market-data": "workspace:*",
    "@upup/pi-runtime": "workspace:*",
    "@upup/utils": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "keywords": [
    "gateway",
    "whatsapp",
    "channel",
    "upup"
  ],
  "private": false
}
