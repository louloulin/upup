{
  "name": "@upup/gateway",
  "version": "0.2.0",
  "description": "UpUp Gateway System - WhatsApp integration, routing, and channel management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@upup/utils": "workspace:*"
  },
  "devDependencies": {
    "@upup/utils": "workspace:*",
    "@types/bun": "latest"
  },
  "keywords": [
    "gateway",
    "whatsapp",
    "channel",
    "upup"
  ],
  "private": false
}
