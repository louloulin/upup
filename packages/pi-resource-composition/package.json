{
  "name": "@upup/pi-resource-composition",
  "version": "0.1.0",
  "description": "Serialized Pi resource reload lifecycle and composition contracts",
  "type": "module",
  "keywords": ["pi-package", "resources", "composition", "lifecycle"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node --external '@upup/*' --external '@earendil-works/*' --external 'typebox' && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts"
  },
  "files": ["dist", "package.json"],
  "dependencies": {
    "@upup/pi-runtime": "0.1.0"
  },
  "pi": { "contract": "upup.pi.runtime.v1", "source": "builtin:upup", "trust": { "mode": "builtin", "filesystem": true }, "lifecycle": { "scope": "runtime" }, "extensions": [], "skills": [], "prompts": [], "workflows": [], "policies": [], "evals": [] }
}
