{
  "name": "@upup/pi-investment-workflow",
  "version": "0.1.0",
  "description": "UpUp Pi-native five-phase investment workflow",
  "type": "module",
  "keywords": [
    "pi-package",
    "finance",
    "investment",
    "workflow"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts ./src/workflow.test.ts ./extensions/index.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@upup/pi-backtest": "0.1.0",
    "@upup/pi-investment-analysis": "0.1.0",
    "@upup/pi-market-data": "0.1.0",
    "@upup/pi-portfolio": "0.1.0",
    "typebox": "1.3.7"
  },
  "pi": {
    "source": "builtin:upup",
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "workflows": [
      "./workflows"
    ],
    "policies": [
      "./policies"
    ],
    "evals": [
      "./evals"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0"
  }
}
