{
  "name": "@upup/pi-investment-workflow",
  "version": "0.1.0",
  "description": "UpUp Pi-native five-phase investment workflow",
  "type": "module",
  "keywords": [
    "pi-package",
    "finance",
    "investment",
    "workflow"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node --external '@upup/*' --external '@earendil-works/*' --external 'typebox' && bun build extensions/index.ts --outdir=dist/extensions --target=node --external '@upup/*' --external '@earendil-works/*' --external 'typebox' && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./src ./extensions"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@upup/pi-backtest": "0.1.0",
    "@upup/pi-investment-analysis": "0.1.0",
    "@upup/pi-market-data": "0.1.0",
    "@upup/pi-risk": "0.1.0",
    "@upup/pi-portfolio": "0.1.0",
    "typebox": "1.3.7"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
   "source": "builtin:upup",
    "tools": ["invest_workflow_phase", "invest_workflow"],
    "nativeTools": ["invest_workflow_phase", "invest_workflow"],
    "trust": { "mode": "builtin", "filesystem": true },
    "hostCapabilities": ["investment-workflow"],
    "lifecycle": { "scope": "session" },
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "workflows": [
      "./workflows"
    ],
    "policies": [
      "./policies"
    ],
    "evals": [
      "./evals"
    ],
    "dependencies": {
      "@upup/pi-storage": "0.2.0",
      "@upup/pi-planning": "0.1.0",
      "@upup/pi-research": "0.1.0",
      "@upup/pi-market-data": "0.1.0",
      "@upup/pi-risk": "0.1.0",
      "@upup/memory": "0.2.0",
      "@upup/utils": "0.2.0",
      "@upup/types": "0.2.0",
      "@upup/pi-capability-registry": "0.1.0"
    }
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0",
    "@upup/pi-runtime": "0.1.0",
    "@upup/pi-storage": "0.2.0",
    "@upup/pi-planning": "0.1.0",
    "@upup/pi-research": "0.1.0",
    "@upup/pi-market-data": "0.1.0",
    "@upup/memory": "0.2.0",
    "@upup/utils": "0.2.0",
    "@upup/types": "0.2.0"
  }
}
