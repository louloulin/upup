{
  "name": "@upup/cron",
  "version": "0.2.0",
  "description": "UpUp Cron System - Cron job types, schedule computation, and job management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./executor": {
      "types": "./src/executor.ts",
      "default": "./src/executor.ts"
    },
    "./schedule": {
      "types": "./src/schedule.ts",
      "default": "./src/schedule.ts"
    },
    "./heartbeat-migration": {
      "types": "./src/heartbeat-migration.ts",
      "default": "./src/heartbeat-migration.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./runner": {
      "types": "./src/runner.ts",
      "default": "./src/runner.ts"
    },
    "./store": {
      "types": "./src/store.ts",
      "default": "./src/store.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "croner": "^9.1.0"
  },
  "peerDependencies": {
    "@upup/types": "workspace:*"
  },
  "devDependencies": {
    "@upup/types": "workspace:*",
    "@types/bun": "latest"
  },
  "keywords": [
    "cron",
    "scheduler",
    "upup",
    "agent"
  ],
  "private": false
}
