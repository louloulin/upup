{
  "name": "@upup/cron",
  "version": "0.2.0",
  "description": "UpUp Cron System - Cron job types, schedule computation, and job management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun --external @upup/pi-runtime --external @upup/gateway --external @earendil-works/pi-ai --external @earendil-works/pi-coding-agent && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "test": "bun test ./src/executor.pi.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@upup/gateway": "0.2.0",
    "@upup/utils": "0.2.0",
    "croner": "9.1.0"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@upup/types": "workspace:*",
    "@types/bun": "latest"
  },
  "keywords": [
    "cron",
    "scheduler",
    "upup",
    "agent"
  ],
  "private": false,
  "pi": {
    "contract": "upup.pi.runtime.v1",
    "source": "builtin:upup",
    "trust": {
      "mode": "builtin",
      "filesystem": true,
      "network": true,
      "credentials": true
    },
    "lifecycle": {
      "scope": "process",
      "dispose": "./src/runner.ts#CronRunner.stop"
    },
    "extensions": [],
    "skills": [],
    "prompts": [],
    "workflows": [],
    "policies": [],
    "evals": []
  }
}
