{
  "name": "@upup/cron",
  "version": "0.1.0",
  "description": "UpUp Cron System - Cron job types, schedule computation, and job management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "croner": "^9.1.0"
  },
  "peerDependencies": {
    "@upup/types": "workspace:*"
  },
  "devDependencies": {
    "@upup/types": "workspace:*",
    "@types/bun": "latest"
  },
  "keywords": [
    "cron",
    "scheduler",
    "upup",
    "agent"
  ],
  "private": false
}
