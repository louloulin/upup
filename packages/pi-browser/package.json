{
  "name": "@upup/pi-browser",
  "version": "0.1.0",
  "description": "UpUp Pi-native interactive browser research tool",
  "type": "module",
  "keywords": ["pi-package", "research", "browser"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node --external=playwright && bun build extensions/index.ts --outdir=dist/extensions --target=node --external=playwright && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "test": "bun test ./test.ts ./extensions/index.test.ts"
  },
  "files": ["dist", "extensions", "skills", "prompts", "workflows", "policies", "evals", "package.json"],
  "peerDependencies": { "@earendil-works/pi-coding-agent": "0.84.3", "typebox": "1.3.7" },
  "pi": {
    "source": "builtin:upup",
    "extensions": ["./extensions"],
    "skills": ["./skills/pi-browser"],
    "prompts": ["./prompts/pi-browser.md"],
    "workflows": ["./workflows/pi-browser.md"],
    "policies": ["./policies/pi-browser.md"],
    "evals": ["./evals/pi-browser.json"]
  }
}
