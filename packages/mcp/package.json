{
  "name": "@upup/mcp",
  "version": "0.2.0",
  "description": "UpUp MCP SDK - Model Context Protocol client implementation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && npx tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=node",
    "test": "bun test"
  },
  "dependencies": {
    "@upup/pi-research": "0.1.0",
    "@upup/pi-runtime": "0.1.0",
    "@upup/pi-storage": "0.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "typebox": "1.3.7",
    "zod": "3.25.76",
    "@upup/utils": "0.2.0"
  },
  "files": [
    "dist"
  ],
  "private": false,
  "pi": {
    "contract": "upup.pi.runtime.v1",
    "source": "builtin:upup",
    "trust": {
      "mode": "sandboxed",
      "network": true
    },
    "lifecycle": {
      "scope": "session"
    },
    "capabilities": [
      { "name": "mcp.client", "version": "1.0.0", "scope": "session", "trust": { "mode": "sandboxed", "network": true }, "lifecycle": { "scope": "session" } }
    ],
    "extensions": [],
    "skills": [],
    "prompts": [],
    "workflows": [],
    "policies": [],
    "evals": []
  }
}
