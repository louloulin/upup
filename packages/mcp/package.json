{
  "name": "@upup/mcp",
  "version": "0.2.0",
  "description": "UpUp MCP SDK - Model Context Protocol client implementation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./auth-tool": {
      "types": "./src/auth-tool.ts",
      "default": "./src/auth-tool.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./resource-tools": {
      "types": "./src/resource-tools.ts",
      "default": "./src/resource-tools.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./mcp/types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./investment-data": {
      "types": "./src/investment-data.ts",
      "default": "./src/investment-data.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && npx tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "dev": "bun build src/index.ts --outdir=dist --watch --target=node",
    "test": "bun test"
  },
  "dependencies": {
    "@langchain/core": "^1.1.44",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@upup/agent-runtime": "workspace:*",
    "@upup/hooks": "workspace:*",
    "@upup/utils": "workspace:*",
    "zod": "^3.0.0"
  },
  "peerDependencies": {
    "@upup/utils": "workspace:*",
    "@upup/hooks": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "private": false
}
