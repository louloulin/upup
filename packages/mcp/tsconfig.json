{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@upup/types": ["../types/src"],
      "@upup/types/*": ["../types/src/*"],
      "@upup/utils": ["../utils/src"],
      "@upup/utils/*": ["../utils/src/*"],
      "@upup/utils/logging": ["../utils/src/logging"],
      "@upup/llm": ["../llm/src"],
      "@upup/hooks/*": ["../hooks/src/*"],
      "@upup/agent-runtime/*": ["../agent-runtime/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
