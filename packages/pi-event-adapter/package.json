{
  "name": "@upup/pi-event-adapter",
  "version": "0.1.0",
  "description": "UpUp canonical event adapter: single production Pi event \u2192 server event mapping",
  "type": "module",
  "keywords": [
    "pi-package",
    "events",
    "adapter",
    "contracts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./pi-model-bridge": {
      "types": "./dist/pi-model-bridge.d.ts",
      "bun": "./src/pi-model-bridge.ts",
      "default": "./dist/pi-model-bridge.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node --external '@upup/*' --external '@earendil-works/*' && bun build src/pi-model-bridge.ts --outdir=dist --target=node --external '@upup/*' --external '@earendil-works/*' && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "pi": { "contract": "upup.pi.runtime.v1", "source": "builtin:upup", "trust": { "mode": "builtin" }, "lifecycle": { "scope": "runtime" }, "extensions": [], "skills": [], "prompts": [], "workflows": [], "policies": [], "evals": [] },
  "dependencies": {
    "@upup/pi-runtime": "0.1.0",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1"
  }
}
