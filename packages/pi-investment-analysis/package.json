{
  "name": "@upup/pi-investment-analysis",
  "version": "0.1.0",
  "description": "UpUp Pi-native valuation and technical analysis tools",
  "type": "module",
  "keywords": [
    "pi-package",
    "finance",
    "valuation",
    "technical-analysis"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "bun run ../../scripts/clean-pi-package-dist.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node && bun build extensions/index.ts --outdir=dist/extensions --target=node && tsc --project tsconfig.json",
    "test": "bun test ./test.ts ./src/research-journal.test.ts ./src/research-coordinator.test.ts ./src/stock-analysis.test.ts ./src/matrix.test.ts ./extensions/index.test.ts"
  },
  "files": [
    "dist",
    "extensions",
    "skills",
    "prompts",
    "workflows",
    "policies",
    "evals",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@upup/pi-market-data": "0.1.0",
    "typebox": "1.3.7"
  },
  "pi": {
    "contract": "upup.pi.runtime.v1",
   "source": "builtin:upup",
    "tools": ["dcf_model","ddm_model","peer_comparison","valuation_ratios","calculate_target_price","quick_target_price","calculate_option_price","calculate_option_greeks","calculate_implied_volatility","decision_dashboard","calculate_technical_indicators","calculate_kdj","calculate_boll","calculate_wr","calculate_cci","calculate_atr","calculate_obv","analyze_symbol","list_research_tasks","matrix_analysis","stock_analysis"],
    "nativeTools": ["dcf_model","ddm_model","peer_comparison","valuation_ratios","calculate_target_price","quick_target_price","calculate_option_price","calculate_option_greeks","calculate_implied_volatility","decision_dashboard","calculate_technical_indicators","calculate_kdj","calculate_boll","calculate_wr","calculate_cci","calculate_atr","calculate_obv","analyze_symbol","list_research_tasks","matrix_analysis","stock_analysis"],
    "trust": { "mode": "builtin", "network": true, "credentials": true },
    "hostCapabilities": ["research-worker"],
    "capabilities": [
      { "name": "financial.evidence", "version": "1.0.0", "scope": "session", "trust": { "mode": "builtin" }, "lifecycle": { "scope": "session" } },
      { "name": "financial.audit", "version": "1.0.0", "scope": "session", "trust": { "mode": "builtin", "filesystem": true }, "lifecycle": { "scope": "session" } }
    ],
    "lifecycle": { "scope": "session" },
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "workflows": [
      "./workflows"
    ],
    "policies": [
      "./policies"
    ],
    "evals": [
      "./evals"
    ]
  },
  "dependencies": {
    "@upup/pi-capability-registry": "0.1.0"
  }
}
