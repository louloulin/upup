    },
    "./server": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "^2026.325.0"
  },
  "peerDependencies": {
    "@upup/agent-core": "*",
    "@upup/state": "*"
  },
  "files": ["index.js", "index.d.ts"]
}