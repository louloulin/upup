{
  "name": "@upup/index-app",
  "version": "0.3.0",
  "description": "UpUp Application Shell - L7 thin entry point",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "build": "echo 'L7 shell - delegates to @upup/cli'",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@upup/cli": "workspace:*",
    "@upup/types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
