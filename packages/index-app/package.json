{
  "name": "@upup/index-app",
  "version": "0.3.0",
  "description": "UpUp Application Shell - L7 thin entry point (subcommands, --stdio, --bridge, interactive CLI, cleanup hooks)",
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./stdio": {
      "types": "./src/stdio/server.ts",
      "default": "./src/stdio/server.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "build": "echo 'L7 shell - delegates to @upup/cli'",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@upup/bridge-system": "workspace:*",
    "@upup/cli": "workspace:*",
    "@upup/coordinator-system": "workspace:*",
    "@upup/types": "workspace:*",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
