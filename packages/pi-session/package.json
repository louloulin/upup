{
  "name": "@upup/pi-session",
  "version": "0.1.0",
  "description": "UpUp Pi session lifecycle adapter and session contract implementation",
  "type": "module",
  "keywords": [
    "pi-package",
    "session",
    "runtime",
    "finance"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node --external '@upup/*' --external '@earendil-works/*' --external 'playwright*' --external 'playwright-core*' --external 'chromium*' --external 'electron*' && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts ./src/host-contract.test.ts ./src/session2.test.ts ./src/restore-advanced.test.ts ./src/finance-host-contract.test.ts ./src/session-service.test.ts ./src/background-service.test.ts"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "pi": {
    "contract": "upup.pi.runtime.v1",
    "source": "builtin:upup",
    "trust": {
      "mode": "builtin",
      "filesystem": true
    },
    "lifecycle": {
      "scope": "session"
    },
    "extensions": [],
    "skills": [],
    "prompts": [],
    "workflows": [],
    "policies": [],
    "evals": [],
    "dependencies": {
      "@upup/pi-prompt-config": "0.1.0"
    }
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@upup/commands": "0.2.0",
    "@upup/pi-event-adapter": "0.1.0",
    "@upup/pi-runtime": "0.1.0",
    "@upup/pi-prompt-config": "0.1.0",
    "@upup/types": "0.2.0",
    "@upup/pi-investment-workflow": "0.1.0",
    "@upup/pi-market-data": "0.1.0",
    "@upup/pi-resource-composition": "0.1.0",
    "@upup/pi-finance-composition": "0.1.0",
    "@upup/pi-platform-composition": "0.1.0",
    "@upup/pi-capability-registry": "0.1.0",
    "@upup/cron": "0.2.0",
    "@upup/utils": "0.2.0",
    "@earendil-works/pi-ai": "0.85.1"
  }
}
