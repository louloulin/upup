{
  "name": "@upup/pi-session",
  "version": "0.1.0",
  "description": "UpUp Pi session lifecycle adapter and session contract implementation",
  "type": "module",
  "keywords": ["pi-package", "session", "runtime", "finance"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node && tsc --emitDeclarationOnly --project tsconfig.json",
    "test": "bun test ./test.ts"
  },
  "files": ["dist", "package.json"],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@upup/pi-event-adapter": "0.1.0",
    "@upup/pi-runtime": "0.1.0"
  }
}
