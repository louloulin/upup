{
  "name": "@upup/plugin-sdk",
  "version": "0.2.0",
  "description": "UpUp Plugin SDK for external plugin development",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts src/manifest.ts --outdir=dist --target=bun && bun build src/index.ts src/manifest.ts --outdir=dist --target=node --format=cjs && rm -rf dist/*.map",
    "dev": "bun build src/index.ts src/manifest.ts --outdir=dist --watch --target=bun",
    "test": "bun test"
  },
  "dependencies": {
    "@upup/types": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "private": false
}
