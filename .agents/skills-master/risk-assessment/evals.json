{
  "skill_name": "risk-assessment",
  "description": "风险评估 - VaR、最大回撤、止损策略",
  "evals": [
    {
      "id": 1,
      "prompt": "我持有腾讯控股，分析最大的下行风险是什么，VaR是多少",
      "expected_output": "风险评估报告",
      "expectations": [
        "识别主要风险因素",
        "计算VaR(95%置信度)",
        "评估最大潜在损失",
        "提出风险缓解建议"
      ]
    },
    {
      "id": 2,
      "prompt": "帮我的投资组合设置合理的止损点，假设最大能承受15%的亏损",
      "expected_output": "止损策略报告",
      "expectations": [
        "基于组合波动率设置止损",
        "分批止损建议",
        "动态调整方案",
        "执行时机建议"
      ]
    },
    {
      "id": 3,
      "prompt": "分析贵州茅台的历史最大回撤发生在什么时候，原因是什么",
      "expected_output": "历史回撤分析",
      "expectations": [
        "找出历史最大回撤",
        "分析回撤原因",
        "评估恢复时间",
        "类比当前市场环境"
      ]
    },
    {
      "id": 4,
      "prompt": "帮我评估持有比亚迪股票的风险，包括行业风险、政策风险和市场风险",
      "expected_output": "多维度风险评估",
      "expectations": [
        "评估行业竞争风险",
        "分析政策风险敞口",
        "评估市场风险",
        "综合风险评级"
      ]
    },
    {
      "id": 5,
      "prompt": "我想要在投资前评估一个股票的风险收益比，应该看哪些指标",
      "expected_output": "风险收益评估指南",
      "expectations": [
        "列出核心指标",
        "解释各指标含义",
        "提供指标阈值参考",
        "说明综合评估方法"
      ]
    }
  ]
}
