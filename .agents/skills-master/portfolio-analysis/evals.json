{
  "skill_name": "portfolio-analysis",
  "description": "投资组合分析 - MPT优化、夏普比率、再平衡",
  "evals": [
    {
      "id": 1,
      "prompt": "我持有苹果、微软、谷歌和亚马逊的股票，分析我的组合风险和收益特征",
      "expected_output": "投资组合分析报告",
      "expectations": [
        "计算各股票权重",
        "计算组合预期收益",
        "评估组合波动率",
        "计算夏普比率"
      ]
    },
    {
      "id": 2,
      "prompt": "帮我的10万元组合做资产配置优化，目标是在控制风险的同时获取最大收益",
      "expected_output": "优化后的资产配置方案",
      "expectations": [
        "确定最优配置比例",
        "计算预期收益和风险",
        "提供再平衡建议",
        "说明优化逻辑"
      ]
    },
    {
      "id": 3,
      "prompt": "分析我的组合是否过度集中于科技股，需要如何分散风险",
      "expected_output": "风险集中度分析和建议",
      "expectations": [
        "识别行业集中度",
        "计算行业风险贡献",
        "提出分散化建议",
        "推荐替代标的"
      ]
    },
    {
      "id": 4,
      "prompt": "我的组合最近下跌了20%，帮我分析是市场因素还是组合问题",
      "expected_output": "回撤分析报告",
      "expectations": [
        "分析回撤原因",
        "区分系统性风险和非系统性风险",
        "评估组合抗跌性",
        "给出应对建议"
      ]
    },
    {
      "id": 5,
      "prompt": "帮我计算我持有的ETF组合的有效前沿，找到最优配置点",
      "expected_output": "有效前沿分析",
      "expectations": [
        "收集ETF历史数据",
        "计算收益率和波动率",
        "绘制有效前沿",
        "标注最优配置点"
      ]
    }
  ]
}
