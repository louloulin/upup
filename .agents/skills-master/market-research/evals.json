{
  "skill_name": "market-research",
  "description": "市场研究 - 市场情绪、资金流向、美林时钟",
  "evals": [
    {
      "id": 1,
      "prompt": "分析当前A股市场情绪，判断现在是牛市还是熊市",
      "expected_output": "市场情绪分析报告",
      "expectations": [
        "分析情绪指标",
        "判断牛熊状态",
        "识别情绪拐点",
        "给出操作建议"
      ]
    },
    {
      "id": 2,
      "prompt": "帮我分析最近的北向资金流向，判断外资对A股的态度",
      "expected_output": "北向资金分析",
      "expectations": [
        "分析近期北向资金",
        "判断外资偏好变化",
        "预测资金流向",
        "给出投资建议"
      ]
    },
    {
      "id": 3,
      "prompt": "现在处于经济周期的哪个阶段，应该如何调整资产配置",
      "expected_output": "美林时钟分析",
      "expectations": [
        "判断当前周期阶段",
        "分析各资产表现",
        "给出配置建议",
        "说明判断依据"
      ]
    },
    {
      "id": 4,
      "prompt": "分析芯片行业当前的市场状况和投资机会",
      "expected_output": "行业分析报告",
      "expectations": [
        "分析行业现状",
        "评估供需关系",
        "识别投资机会",
        "提示风险因素"
      ]
    },
    {
      "id": 5,
      "prompt": "帮我分析新能源汽车行业的市场渗透率和增长潜力",
      "expected_output": "行业增长分析",
      "expectations": [
        "分析渗透率数据",
        "评估增长空间",
        "识别增长驱动因素",
        "分析主要参与者"
      ]
    }
  ]
}
