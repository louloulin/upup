  "evals": [
    {
      "id": 1,
      "prompt": "帮我分析苹果公司的资产负债表，评估财务健康度",
      "expected_output": "资产负债表分析",
      "expectations": [
        "解读资产负债表",
        "分析资产结构",
        "评估负债水平",
        "给出财务健康评分"
      ]
    },
    {
      "id": 2,
      "prompt": "分析茅台的现金流量表，判断盈利质量",
      "expected_output": "现金流分析",
      "expectations": [
        "分析经营现金流",
        "评估投资现金流",
        "分析融资现金流",
        "判断盈利质量"
      ]
    },
    {
      "id": 3,
      "prompt": "帮我计算并解释ROE、ROA和ROIC的区别",
      "expected_output": "盈利能力指标对比",
      "expectations": [
        "解释各指标定义",
        "计算公式对比",
        "分析适用场景",
        "给出茅台的数值"
      ]
    },
    {
      "id": 4,
      "prompt": "分析比亚迪的财务数据，找出财务风险点",
      "expected_output": "财务风险识别",
      "expectations": [
        "识别异常指标",
        "分析债务风险",
        "检查现金流",
        "给出风险评估"
      ]
    },
    {
      "id": 5,
      "prompt": "帮我对比分析三家科技公司的财务健康度",
      "expected_output": "横向财务对比",
      "expectations": [
        "收集三家公司数据",
        "对比关键指标",
        "分析差异原因",
        "给出综合排序"
      ]
    }
  ]
